# Used by Better Auth and worker — change in production
AUTH_SECRET=replace-me-with-32-plus-random-chars

# SQLite location. In Docker this should be file:/data/voicenotes.db
DATABASE_URL=file:./data/voicenotes.db

# Public base URL (no trailing slash). In production: https://notes.cugovci.uk
NEXT_PUBLIC_URL=http://localhost:3000

# Transcription backend. If GROQ_API_KEY is set, the worker uses Groq's
# hosted Whisper-large-v3 (free tier ≈ 4h/day audio — far above family use).
# Get a key at https://console.groq.com/keys (free, just email).
# Leave empty to fall back to the local Python faster-whisper subprocess.
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3

# Used by the local Python fallback only (when GROQ_API_KEY is empty).
# CPU-only on the VM — medium is the sweet spot for SK+EN.
# One of: tiny | base | small | medium | large-v3
WHISPER_MODEL=medium

# Where to store uploaded audio files (host path or volume mount)
AUDIO_DIR=./data/audio

# Background worker poll interval (ms)
WORKER_POLL_MS=5000
